    "file_start": 0.0,
    "fade_in": 1.5,
    "fade_out": 3.0,
    "loop": true,
    "duck_under_voice": true,
    "duck_ratio": 6.0
  },
  "dubbing": {
    "folder": "takes",
    "volume": 1.0,
    "latency_ms": 0,
    "takes": []
  }
