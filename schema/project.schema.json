{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knhanul/dubbing/schema/project.schema.json",
  "title": "영상 합성기 프로젝트",
  "type": "object",
  "required": [
    "clips"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4320,
          "multipleOf": 2
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "original_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "crossfade",
            "wipeleft",
            "wiperight",
            "wipeup",
            "wipedown",
            "slideleft",
            "slideright",
            "slideup",
            "slidedown",
            "circleopen",
            "circleclose",
            "dissolve",
            "smoothleft",
            "smoothright",
            "radial",
            "zoomin"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "duration": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "motion": {
            "type": "string",
            "enum": [
              "none",
              "zoom_in",
              "zoom_out",
              "pan_left",
              "pan_right",
              "pan_up",
              "pan_down",
              "zoom_in_left",
              "zoom_in_right",
              "ken_burns"
            ]
          },
          "motion_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "motion_easing": {
            "type": "string",
            "enum": [
              "linear",
              "ease"
            ]
          },
          "speed": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 16
          },
          "fit_duration": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "trim_start": {
            "type": "number",
            "minimum": 0
          },
          "trim_end": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "mute": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "fit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "cover",
              "contain",
              null
            ]
          },
          "transition": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "none",
                      "fade",
                      "crossfade",
                      "wipeleft",
                      "wiperight",
                      "wipeup",
                      "wipedown",
                      "slideleft",
                      "slideright",
                      "slideup",
                      "slidedown",
                      "circleopen",
                      "circleclose",
                      "dissolve",
                      "smoothleft",
                      "smoothright",
                      "radial",
                      "zoomin"
                    ]
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "subtitle": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": "number"
        },
        "burn_in": {
          "type": "boolean"
        },
        "style": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 8,
              "maximum": 300
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outline": {
              "type": "number",
              "minimum": 0
            },
            "bold": {
              "type": "boolean"
            },
            "margin_v": {
              "type": "integer",
              "minimum": 0
            },
            "position": {
              "enum": [
                "bottom",
                "center",
                "top"
              ]
            },
            "box": {
              "type": "boolean"
            },
            "box_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "box_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "box_padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "appear": {
              "enum": [
                "none",
                "fade",
                "typing",
                "slide_up",
                "pop"
              ]
            },
            "appear_duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "index",
              "start",
              "end",
              "text"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "bgm": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "start_offset": {
          "type": "number",
          "minimum": 0
        },
        "file_start": {
          "type": "number",
          "minimum": 0
        },
        "fade_in": {
          "type": "number",
          "minimum": 0
        },
        "fade_out": {
          "type": "number",
          "minimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "duck_under_voice": {
          "type": "boolean"
        },
        "duck_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "description": "타임라인 트랙 켜고 끄기 (프로그램이 관리, AI 는 쓰지 않아도 됨)",
      "properties": {
        "clips": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hidden": {
              "type": "boolean"
            },
            "muted": {
              "type": "boolean"
            },
            "solo": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          }
        },
        "subtitle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hidden": {
              "type": "boolean"
            },
            "muted": {
              "type": "boolean"
            },
            "solo": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          }
        },
        "dubbing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hidden": {
              "type": "boolean"
            },
            "muted": {
              "type": "boolean"
            },
            "solo": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          }
        },
        "bgm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hidden": {
              "type": "boolean"
            },
            "muted": {
              "type": "boolean"
            },
            "solo": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "dubbing": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "latency_ms": {
          "type": "number"
        },
        "takes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "subtitle": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "offset": {
                "type": "number"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
